.warningInputField > .unity-label {
    color: rgb(255, 87, 28);
}

.warningInputField > .unity-base-field__input {
    border-color: rgb(255, 87, 28);
}

AllowedNeighborList .header {
    -unity-font-style: bold;
    margin: 5px 0 5px 0;
    margin-bottom: 3px;
    margin-top: 4px;
}

AllowedNeighborList .indentation {
    width: 35px;
}

AllowedNeighborList {
    flex-direction: row;
    margin-bottom: 10px;
}

AllowedNeighborList > .list {
    flex-grow: 1;
}

AllowedNeighborListElement {
    flex-direction: row;
    align-items: center;
    background-color: rgba(90, 90, 90, 0.7);
    border-radius: 5px;
    justify-content: space-between;
    margin-right: 10px;
    margin-bottom: 2px;
    margin-top: 2px;
}

.allowed-neighbor {
    background-color: rgb(105, 105, 105);
}

AllowedNeighborListElement > Switch {
    margin-right: 5px;
}

.allowed-neighbor-sublist {
    margin-bottom: 10px;
}

Button {
    padding-top: 4px;
    padding-bottom: 4px;
}

.sub-block-list-element {
    background-color: rgb(46, 46, 46);
    margin: 2px 0 2px 0;
    font-size: 12px;
}

.sub-block-list-element Button {
    font-size: 12px;
    margin-right: 0;
}

.variant-list-element-main > #PreviewImageContainer {
    display: none;
}

.variant-list-element-main > #NameLabel {
    display: flex;
    -unity-font-style: bold;
}

.variant-list-element-main > #DeleteButton {
    display: none;
}

.variant-list {
    margin-right: 5px;
    margin-left: 2px;
}

.variant-list-element-main {
    display: flex;
    margin-top: 5px;
    margin-bottom: 5px;
}

.variant-list-element {
    margin-top: 1px;
    margin-bottom: 1px;
}

.variant-list-element-main {
}

.sub-block-type-tag-top {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    color: rgb(31, 41, 43);
    -unity-font-style: bold;
    background-color: rgb(155, 193, 202);
    border-left-color: rgb(105, 129, 135);
    border-right-color: rgb(105, 129, 135);
    border-top-color: rgb(105, 129, 135);
    border-bottom-color: rgb(105, 129, 135);
}

.sub-block-type-tag-middle {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-color: rgb(51, 119, 135);
    color: rgb(17, 38, 43);
    -unity-font-style: bold;
    border-left-color: rgb(27, 69, 79);
    border-right-color: rgb(27, 69, 79);
    border-top-color: rgb(27, 69, 79);
    border-bottom-color: rgb(27, 69, 79);
}

.sub-block-type-tag-bottom {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(4, 71, 87);
    border-right-color: rgb(4, 71, 87);
    border-top-color: rgb(4, 71, 87);
    border-bottom-color: rgb(4, 71, 87);
    background-color: rgb(0, 43, 53);
    color: rgb(176, 197, 202);
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}
