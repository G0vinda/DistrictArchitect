.warningInputField > .unity-label {
    color: rgb(255, 87, 28);
}

.warningInputField > .unity-base-field__input {
    border-color: rgb(255, 87, 28);
}

AllowedNeighborList .header {
    -unity-font-style: bold;
    margin: 5px 0 5px 0;
}

AllowedNeighborList .indentation {
    width: 35px;
}

AllowedNeighborList {
    flex-direction: row;
    margin-bottom: 10px;
}

AllowedNeighborList > .list {
    flex-grow: 1;
}

AllowedNeighborListElement {
    flex-direction: row;
    align-items: center;
    background-color: rgba(90, 90, 90, 0.7);
    border-radius: 5px;
    justify-content: space-between;
    margin-right: 10px;
    margin-bottom: 3px;
    margin-top: 3px;
}

.allowed-neighbor {
    background-color: rgba(105, 105, 105, 1);
}

AllowedNeighborListElement > Switch {
    margin-right: 5px;
}

.sub-block-list-element {
    background-color: rgb(46, 46, 46);
    margin: 2px 0 2px 0;
}